# 复制为 .env 后按实际环境修改。.env 与 secrets/ 已被 .gitignore 排除。
# 镜像必须带版本号；回滚时改回上一版 tag 再 docker compose up -d。
MCU_IMAGE=mcu-xiaozhi:0.1.0
MCU_PORT=8090
MCU_HOME=/srv/mcu-xiaozhi
MCU_SECRET_DIR=./secrets

# 生产反代前缀（与 /v360/ 并列）；本地直连调试可留空
MCU_ROOT_PATH=/mcu-xiaozhi
MCU_SECURE_COOKIES=1
MCU_USERNAME=mcu

# 开发/验收用 mock；联调与生产改为 real
COZE_MODE=mock
COZE_API_BASE=https://api.coze.cn
# 真实 bot_id 由用户提供；仓库内只用占位值
COZE_BOT_ID=PLACEHOLDER_BOT_ID

MCU_MAX_UPLOAD_BYTES=8388608